# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Entornos Virtuales ---
.venv/
venv/
ENV/
env.bak/
venv.bak/
agente_env/

# --- Variables de Entorno y Secretos ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.flaskenv

# --- Base de Datos Vectorial (ChromaDB) ---
app/data/chroma_db/
chroma_db/
data/chroma_db/
data/chroma_db*/
*.local.storage

# --- Playwright y Navegadores ---
.playwright/
browser_data/

# --- IDEs y Editores ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# --- Logs y Temporales ---
*.log
logs/
tmp/
.pytest_cache/
.coverage
htmlcov/

*.onnx
*.bin

# --- Legislación (PDFs grandes — se cargan en el servidor, no van en git) ---
data/legislacion/*.pdf
data/legislacion/*.PDF

# --- Runtime / Stats ---
data/usage_stats.json
data/kb_config.json
data/checkpoints.db

# --- Documentos del centro (RGPD) ---
# Ni los PDFs del centro ni la base vectorial que los contiene indexados van en
# git: viven en el volumen del despliegue y se gestionan desde el panel de
# administración. En un repo acaban publicados y no hay forma de despublicarlos.
data/*.pdf
data/*.PDF
data/centro/*
!data/centro/README.md
!data/centro/.gitkeep
