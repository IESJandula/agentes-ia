# ─────────────────────────────────────────────────────────────────────────────
# Autenticación (Keycloak) — OBLIGATORIA
#
# Mismo realm que el resto de aplicaciones del centro: el token con el que un
# profesor entra en Guardias o en Accesos vale aquí sin volver a identificarse.
# KEYCLOAK_ISSUER tiene que ser EXACTAMENTE el mismo valor que usan core-data y
# accesos-api; si diverge, el "un solo login" se rompe.
#
# No hay forma de arrancar sin esto: la app no tiene modo "sin autenticación".
# ─────────────────────────────────────────────────────────────────────────────
KEYCLOAK_ISSUER=http://localhost:8080/realms/vegaies

# Lo que el navegador necesita para el login (lo sirve /api/config).
# Son públicos: viajan en claro en cada redirección de Keycloak.
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=vegaies
KEYCLOAK_CLIENT=agentes

# Opcional: si algún día se configura un audience mapper propio en el cliente,
# ponlo aquí y la validación de audiencia se activa sola. Vacío = no se valida
# (Keycloak pone `aud: account` en los clientes públicos).
# KEYCLOAK_AUDIENCE=

# ─────────────────────────────────────────────────────────────────────────────
# Modelos y búsqueda
# ─────────────────────────────────────────────────────────────────────────────
# API key de Google AI Studio (LLM y embeddings por defecto).
GOOGLE_API_KEY=

# API key de Tavily para la búsqueda web.
TAVILY_API_KEY=

# Proveedor de embeddings: gemini (por defecto) | ollama.
# OJO: cambiarlo cambia la dimensión de los vectores y obliga a REINDEXAR.
# EMBED_PROVIDER=gemini
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_EMBED_MODEL=nomic-embed-text
# OLLAMA_EMBED_DIM=768

# ─────────────────────────────────────────────────────────────────────────────
# Indexación masiva (seed)
#
# Se dejan en false y se activan puntualmente: con embeddings de Gemini free
# tier (5 req/min) reindexar los PDFs de legislación agota la cuota. Tras el
# seed, vuelve a ponerlos en false.
# ─────────────────────────────────────────────────────────────────────────────
SEED_LEGISLACION=false
SEED_CENTRO=false

# ─────────────────────────────────────────────────────────────────────────────
# Red
# ─────────────────────────────────────────────────────────────────────────────
# Orígenes permitidos por CORS, separados por comas. Vacío = "*" sin credenciales.
# CORS_ORIGINS=https://agente.tucentro.es
